# Telegram Bot Configuration
# 1. Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather_here

# 2. Get TELEGRAM_USER_ID from @userinfobot on Telegram (numerical ID, e.g. 123456789)
TELEGRAM_USER_ID=your_numerical_chat_id_here

# Optional: Timezone configuration (defaults to Asia/Kolkata)
TIMEZONE=Asia/Kolkata
